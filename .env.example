# Seconds between scrape cycles; optional, defaults to 3600 (1 hour)
POLL_INTERVAL_SECONDS=3600

# SMTP settings for the email digest notifier
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# For Gmail, this must be an App Password, not your account password:
# https://myaccount.google.com/apppasswords (requires 2-Step Verification enabled)
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Comma-separated recipient addresses
EMAIL_TO=
