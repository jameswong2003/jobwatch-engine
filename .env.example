# Seconds between scrape cycles; optional, defaults to 3600 (1 hour)
POLL_INTERVAL_SECONDS=3600

# PostgreSQL SQLAlchemy URL (required). The PostgreSQL server and database must
# already exist; JobWatch creates its tables on startup.
# Local: postgresql+psycopg://jobwatch:password@localhost:5432/jobwatch
# Remote providers may require SSL, for example: ?sslmode=require
DATABASE_URL=

# Maximum number of company boards scraped at the same time; defaults to 10
MAX_CONCURRENT_COMPANY_SCRAPES=10
